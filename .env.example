# Server-only values. Configure them in Vercel Preview settings or a local ignored env file.
RISKDESK_DATABASE_URL=
RISKDESK_OPERATOR_USERNAME=
RISKDESK_OPERATOR_PASSWORD=
RISKDESK_ALLOWED_ORIGINS=
RISKDESK_DEMO_MODE=false
RISKDESK_DB_POOL_SIZE=1
RISKDESK_DB_MAX_OVERFLOW=1
RISKDESK_DB_POOL_RECYCLE_SECONDS=300

# Operator-only values for explicit migration/seed commands. Do not add these to frontend VITE_* variables.
RISKDESK_MIGRATION_DATABASE_URL=
RISKDESK_DEPLOYMENT_ENV=preview
RISKDESK_PREVIEW_SEED_ENABLED=false
